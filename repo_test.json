      "id": "cinepro-core",
      "name": "CinePro Core",
      "versionId": "1.0",
      "descriptionName": "CinePro OMSS / Stremio",
      "type": "provider",
      "category": "general",
      "enabled": true,
      "priority": 90,
      "supportedMediaTypes": [
        "movie",
        "tv"
      ],
      "capabilities": [
        "movies",
        "series",
        "episodes",
        "stream"
      ],
      "source": {
        "type": "stremio",
        "resolver": "tmdb",
        "repositoryUrl": "https://github.com/cinepro-org/core",
        "manifestPath": "/stremio/manifest.json",
        "streamPath": "/stremio/stream/{type}/{id}.json"
      },
      "description": "Provider de referencia que acepta tmdb:<id> y tmdb:<id>:<season>:<episode> y expone streams mediante Stremio. Requiere una instancia autorizada/propia de CinePro Core; CineVision debe implementar StremioAddonAdapter."
    },
